{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "addresses": [
    "*@banker-thaovy3.tokyo",
    "*@cybersafe.tokyo",
    "*@hominhquan71.tokyo",
    "*@kenjaku.online",
    "*@thaovy-veo3hub.tokyo",
    "*@vdmov1.tokyo",
    "*@vywife71.tokyo"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "MAILBOXES", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1-mailbox", "new_sqlite_classes": ["Mailbox"] }],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/health"]
  },
  "kv_namespaces": [
    {
      "binding": "MAIL_KV",
      "id": "b9bd68f316b444e6873a24e25510c5dd"
    }
  ],
  "secrets": {
    "required": ["API_AUTH_TOKEN"]
  },
  "vars": {
    "APP_ENV": "production",
    "MAIL_RETENTION_SECONDS": "0",
    "MAIL_DOMAINS": "banker-thaovy3.tokyo,cybersafe.tokyo,hominhquan71.tokyo,kenjaku.online,thaovy-veo3hub.tokyo,vdmov1.tokyo,vywife71.tokyo"
  }
}
